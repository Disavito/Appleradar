# ==========================================
# MACRADAR WORKER CONFIGURATION
# ==========================================

# 1. Proxies Residenciales (Obligatorio para evitar baneos de FB en VPS)
PROXY_SERVER=http://tu-proxy-host:puerto
PROXY_USER=tu_usuario_proxy
PROXY_PASS=tu_password_proxy

# 2. Google Gemini API (Para extracción de características con gemini-2.5-flash)
GEMINI_API_KEY=AIzaSy...tu_gemini_api_key

# 3. Firebase Admin SDK
# Puedes pegar el JSON completo en una sola línea o la ruta a serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"macradar-prod",...}
FIRESTORE_COLLECTION=listings

# 4. Parámetros de ejecución
CRON_SCHEDULE=0 */3 * * *
RUN_ON_BOOT=true
